{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "EVE: Backend (nodemon)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "eve-backend",
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "EVE backend running on port"
        }
      },
      "presentation": {
        "group": "eve",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "EVE: Frontend (vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "eve-frontend",
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "ready in"
        }
      },
      "presentation": {
        "group": "eve",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "EVE: Run Full Stack",
      "dependsOn": ["EVE: Backend (nodemon)", "EVE: Frontend (vite)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
